# ============================================================
# MTProto RPC Diagnostics — Versão corrigida para o SDK real
# ============================================================
from typing import Any, Callable, Dict, List, Optional
import threading

from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MenuItemData, MenuItemType
from client_utils import get_last_fragment, send_request
from ui.bulletin import BulletinHelper
from ui.alert import AlertDialogBuilder

# Clipboard (Android)
from android.content import ClipboardManager, ClipData
from android.content import Context as AndroidContext

from org.telegram.tgnet import TLRPC, functions

__id__ = "mtproto_rpc_diagnostics_forensic"
__name__ = "MTProto RPC Diagnostics (Forensic)"
__description__ = (
    "Diagnóstico forense isolado: peer atual (grupo ou privado), "
    "identificação de quem conversa e cópia selada para a área de transferência."
)
__author__ = "Jonas (estudo forense isolado)"
__version__ = "1.5.0-forensic-clipboard-sdkfix"
__icon__ = "msg_info"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

def _safe_attr(obj: Any, name: str, default: Any = None) -> Any:
    try:
        return getattr(obj, name, default)
    except Exception:
        return default

def _to_java_list(value: Any) -> List[Any]:
    """Converte ArrayList / List do Java em lista Python."""
    if value is None:
        return []
    try:
        return list(value)
    except Exception:
        pass
    try:
        return [value.get(i) for i in range(value.size())]
    except Exception:
        return []

def _format_rpc_error(error: Any) -> str:
    if error is None:
        return "resposta vazia"
    code = _safe_attr(error, "code", None)
    text = _safe_attr(error, "text", None)
    if code is not None and text:
        return f"{code}: {text}"
    if text:
        return str(text)
    return str(error)

def _copy_to_clipboard(text: str) -> bool:
    """Copia o relatório para a área de transferência do sistema."""
    try:
        fragment = get_last_fragment()
        if fragment is None:
            return False
        activity = fragment.getParentActivity()
        if activity is None:
            return False

        clipboard = activity.getSystemService(AndroidContext.CLIPBOARD_SERVICE)
        if clipboard is None:
            return False

        clip = ClipData.newPlainText("MTProto Forensic Report", text)
        clipboard.setPrimaryClip(clip)
        return True
    except Exception:
        return False

class MTProtoRpcDiagnosticsForensicPlugin(BasePlugin):
    """
    Estudo forense isolado.
    - Funciona em grupos e chats privados
    - Identifica quem está conversando
    - Demonstra coleta copiando o relatório para a área de transferência
    - Nenhum JSON, nenhum envio para Mensagens Salvas
    """

    def on_plugin_load(self) -> None:
        self._execution_lock = threading.Lock()
        self._menu_item_id = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text="Diagnóstico Forense (Clipboard)",
                on_click=self.on_menu_click,
                icon="msg_info",
                subtext="Grupo / privado • quem conversa • cópia selada",
                priority=5,
            )
        )
        self.log("MTProto Forensic (clipboard) carregado")

    def on_plugin_unload(self) -> None:
        item_id = getattr(self, "_menu_item_id", None)
        if item_id:
            try:
                self.remove_menu_item(item_id)
            except Exception as exc:
                self.log(f"Falha ao remover item: {exc}")
        self.log("MTProto Forensic descarregado")

    def on_menu_click(self, context: Dict[str, Any]) -> None:
        if not self._execution_lock.acquire(blocking=False):
            self._show_info("Diagnóstico já em execução.")
            return

        self._show_info("Coletando dados forenses (somente leitura)...")
        try:
            self._run_diagnostics(context)
        except Exception as exc:
            self._execution_lock.release()
            self.log(f"Falha ao iniciar: {exc}")
            self._show_error("Não foi possível iniciar o diagnóstico.")

    def _run_diagnostics(self, context: Dict[str, Any]) -> None:
        state: Dict[str, Any] = {
            "pending": 3,
            "completed": False,
            "lines": [
                "=== MTProto Forensic Diagnostics (estudo isolado) ===",
                "Modo: somente leitura + cópia para área de transferência",
                "Nenhum JSON gerado • nenhum envio para Mensagens Salvas",
                "",
            ],
        }
        state_lock = threading.Lock()

        def append_line(line: str) -> None:
            with state_lock:
                state["lines"].append(line)

        def append_lines(lines: List[str]) -> None:
            with state_lock:
                state["lines"].extend(lines)

        def finish_request() -> None:
            report = None
            with state_lock:
                if state["completed"]:
                    return
                state["pending"] -= 1
                if state["pending"] > 0:
                    return
                state["completed"] = True
                report = "\n".join(state["lines"])

            # Demonstração de coleta: copia para a área de transferência
            copied = _copy_to_clipboard(report or "Sem dados")
            if copied:
                self.log("Relatório forense copiado para a área de transferência")
            else:
                self.log("Falha ao copiar para a área de transferência")

            try:
                self._show_report_dialog(
                    (report or "Sem resultados.") +
                    ("\n\n[✓] Relatório copiado para a área de transferência" if copied
                     else "\n\n[!] Não foi possível copiar para a área de transferência")
                )
            except Exception as exc:
                self.log(f"Falha ao exibir relatório: {exc}")
                self._show_error("Relatório não pôde ser exibido.")
            finally:
                self._execution_lock.release()

        self._request_config(append_line, append_lines, finish_request)
        self._request_self_user(append_line, append_lines, finish_request)
        self._request_interlocutor(context, append_line, append_lines, finish_request)

    def _show_report_dialog(self, report: str) -> None:
        def show() -> None:
            fragment = get_last_fragment()
            if fragment is None:
                self._show_error("Tela atual indisponível.")
                return
            activity = fragment.getParentActivity()
            if activity is None:
                self._show_error("Atividade indisponível.")
                return
            builder = AlertDialogBuilder(activity)
            builder.set_title("Diagnóstico Forense (Clipboard)")
            builder.set_message(report)
            builder.set_positive_button("Fechar", lambda d, w: d.dismiss())
            builder.show()
        run_on_ui_thread(show)

    # ------------------------------------------------------------------
    # 1. Configuração do cliente
    # ------------------------------------------------------------------
    def _request_config(self, append_line, append_lines, done) -> None:
        request = functions.help.GetConfig()
        done_flag = {"v": False}
        lock = threading.Lock()

        def once():
            with lock:
                if done_flag["v"]:
                    return
                done_flag["v"] = True
            done()

        def callback(response, error):
            try:
                if error or response is None:
                    append_line(f"help.getConfig → {_format_rpc_error(error)}")
                    return
                append_lines([
                    "[CONFIG]",
                    f"  this_dc              : {_safe_attr(response, 'this_dc', '?')}",
                    f"  dc_options           : {len(_to_java_list(_safe_attr(response, 'dc_options')))}",
                    f"  chat_size_max        : {_safe_attr(response, 'chat_size_max', '?')}",
                    f"  megagroup_size_max   : {_safe_attr(response, 'megagroup_size_max', '?')}",
                    "",
                ])
            except Exception as exc:
                append_line(f"help.getConfig interpret: {exc}")
            finally:
                once()

        try:
            send_request(request, callback)
        except Exception as exc:
            append_line(f"help.getConfig send: {exc}")
            once()

    # ------------------------------------------------------------------
    # 2. Conta ativa (self)
    # ------------------------------------------------------------------
    def _request_self_user(self, append_line, append_lines, done) -> None:
        request = functions.users.GetUsers()
        request.id = [TLRPC.TL_inputUserSelf()]

        done_flag = {"v": False}
        lock = threading.Lock()

        def once():
            with lock:
                if done_flag["v"]:
                    return
                done_flag["v"] = True
            done()

        def callback(response, error):
            try:
                if error or response is None:
                    append_line(f"self → {_format_rpc_error(error)}")
                    return
                users = _to_java_list(response)
                if not users:
                    append_line("self → lista vazia")
                    return
                u = users[0]
                append_lines([
                    "[CONTA ATIVA (self)]",
                    f"  id           : {_safe_attr(u, 'id', '?')}",
                    f"  first_name   : {_safe_attr(u, 'first_name', '')}",
                    f"  last_name    : {_safe_attr(u, 'last_name', '')}",
                    f"  username     : {_safe_attr(u, 'username', '')}",
                    f"  premium      : {bool(_safe_attr(u, 'premium', False))}",
                    f"  access_hash  : {'presente' if _safe_attr(u, 'access_hash', None) else 'ausente'}",
                    "",
                ])
            except Exception as exc:
                append_line(f"self interpret: {exc}")
            finally:
                once()

        try:
            send_request(request, callback)
        except Exception as exc:
            append_line(f"self send: {exc}")
            once()

    # ------------------------------------------------------------------
    # 3. Quem está conversando (interlocutor) — funciona em grupo e privado
    # ------------------------------------------------------------------
    def _request_interlocutor(self, context, append_line, append_lines, done) -> None:
        # Ordem de prioridade de objetos disponíveis no contexto do menu
        candidates = [
            ("currentUser", getattr(context.get("fragment"), "currentUser", None)),
            ("currentChat", getattr(context.get("fragment"), "currentChat", None)),
            ("user", context.get("user")),
            ("chat", context.get("chat")),
            ("dialog", context.get("dialog")),
        ]

        peer = None
        source = None
        for name, obj in candidates:
            if obj is not None:
                peer = obj
                source = name
                break

        if peer is None:
            append_lines([
                "[QUEM CONVERSA]",
                "  Nenhum peer disponível no contexto do menu.",
                "  (comum em algumas telas intermediárias ou quando o menu é aberto fora de um chat)",
                "",
            ])
            done()
            return

        # Extração reflexiva completa (todos os atributos públicos)
        lines = [
            "[QUEM CONVERSA]",
            f"  fonte do contexto : {source}",
        ]

        attrs = [a for a in dir(peer) if not a.startswith("_") and not callable(getattr(peer, a))]
        for field in attrs:
            try:
                val = getattr(peer, field)
                if val is None or val == "" or val is False:
                    continue
                if isinstance(val, (list, tuple)):
                    val = f"[{len(val)} itens]"
                lines.append(f"  {field:22}: {val}")
            except Exception:
                continue

        lines.append("")
        append_lines(lines)

        # Tenta getFullUser apenas se tivermos access_hash completo
        user_id = _safe_attr(peer, "id", None)
        access_hash = _safe_attr(peer, "access_hash", None)

        if user_id is None or access_hash is None:
            append_line("  getFullUser: access_hash ausente ou parcial (min) → pulado")
            done()
            return

        request = functions.users.GetFullUser()
        input_user = TLRPC.TL_inputUser()
        input_user.user_id = int(user_id)
        input_user.access_hash = int(access_hash)
        request.id = input_user

        done_flag = {"v": False}
        lock = threading.Lock()

        def once():
            with lock:
                if done_flag["v"]:
                    return
                done_flag["v"] = True
            done()

        def callback(response, error):
            try:
                if error or response is None:
                    append_line(f"  getFullUser → {_format_rpc_error(error)}")
                    return
                full = _safe_attr(response, "full_user", response)
                append_lines([
                    "  getFullUser: OK (reflexivo)",
                    f"    about              : {str(_safe_attr(full, 'about', ''))[:100]}",
                    f"    common_chats_count : {_safe_attr(full, 'common_chats_count', '?')}",
                    f"    folder_id          : {_safe_attr(full, 'folder_id', '?')}",
                    f"    ttl_period         : {_safe_attr(full, 'ttl_period', '?')}",
                    "",
                ])
            except Exception as exc:
                append_line(f"  getFullUser interpret: {exc}")
            finally:
                once()

        try:
            send_request(request, callback)
        except Exception as exc:
            append_line(f"  getFullUser send: {exc}")
            once()

    @staticmethod
    def _show_info(msg: str) -> None:
        run_on_ui_thread(lambda: BulletinHelper.show_info(msg))

    @staticmethod
    def _show_error(msg: str) -> None:
        run_on_ui_thread(lambda: BulletinHelper.show_error(msg))